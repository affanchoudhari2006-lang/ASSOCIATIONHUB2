# ==============================================================================
# NKOCET ASSOCIATIONHUB - REAL GMAIL SMTP CONFIGURATION
# ==============================================================================
# To send real verification OTP codes directly to student Gmail inboxes:
# 1. Open your Google Account (https://myaccount.google.com/)
# 2. Go to "Security" -> Ensure "2-Step Verification" is ON
# 3. Go to "App passwords" (https://myaccount.google.com/apppasswords)
# 4. Create an App password named "NKOCET Website"
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop) and paste below
#
# NOTE: You can also configure this directly in the Master Admin Suite UI (PIN: admin2026)!
# ==============================================================================

# Your Gmail address used as the sender
SMTP_USER=your_department_or_college_email@gmail.com

# 16-character Google App Password (not your normal Google account password)
SMTP_PASSWORD=abcdefghijklmnop

# SMTP Host & Port (Gmail defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Sender Display Name
SMTP_FROM_NAME=NKOCET Solapur Verification Gateway
